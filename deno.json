{
  "nodeModulesDir": "auto",
  "lock": true,
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.13.7",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/path": "jsr:@std/path@^1",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "daisyui": "npm:daisyui@^5.5.23",
    "@tailwindcss/cli": "npm:@tailwindcss/cli@^4.3.3"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "@hono/hono/jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "tasks": {
    "probe": "deno run --env-file --allow-env --allow-net --allow-read src/cli/probe.ts",
    "keepalive": "deno run --env-file --allow-env --allow-net --allow-read src/cli/keepalive.ts",
    "daemon": "deno run --env-file --allow-env --allow-net --allow-read --allow-write src/cli/daemon.ts",
    "list-devices": "deno run --env-file --allow-env --allow-net --allow-read src/cli/list-devices.ts",
    "css": "npx tailwindcss -i src/client/styles.css -o assets/styles.css --minify",
    "css:watch": "npx tailwindcss -i src/client/styles.css -o assets/styles.css --watch",
    "client": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run scripts/bundle-client.ts",
    "verify:client": "deno run -A --no-lock scripts/verify-client.ts",
    "server": "deno run --env-file --allow-env --allow-net --allow-read --allow-write src/server/main.ts",
    "dev": "deno task css && deno task client && deno task server",
    "test": "deno test --allow-env --allow-read",
    "check": "deno check src/ && deno lint && deno fmt --check"
  },
  "lint": {
    "include": ["src/"],
    "rules": {
      "tags": ["recommended"],
      "include": ["no-sync-fn-in-async-fn", "no-throw-literal", "eqeqeq"]
    }
  },
  "fmt": {
    "include": ["src/"],
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "exclude": [
    "dist/",
    "assets/app.css",
    "assets/client.js",
    "docs/bundle-snapshots/",
    "src/client/"
  ]
}
